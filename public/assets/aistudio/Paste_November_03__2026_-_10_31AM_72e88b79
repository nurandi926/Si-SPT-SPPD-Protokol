        function formatTanggalIndo(stringTanggal) {
            if (!stringTanggal || stringTanggal === "-") return "-";
            const opsi = { year: 'numeric', month: 'long', day: 'numeric' };
            return new Date(stringTanggal).toLocaleDateString('id-ID', opsi);
        }

        function terbilangRupiah(nominal) {
            var bilangan = ["", "Satu", "Dua", "Tiga", "Empat", "Lima", "Enam", "Tujuh", "Delapan", "Sembilan", "Sepuluh", "Sebelas"];
            var temp = "";
            if (nominal < 12) { temp = " " + bilangan[nominal]; }
            else if (nominal < 20) { temp = terbilangRupiah(nominal - 10) + " Belas"; }
            else if (nominal < 100) { temp = terbilangRupiah(Math.floor(nominal / 10)) + " Puluh" + terbilangRupiah(nominal % 10); }
            else if (nominal < 200) { temp = " Seratus" + terbilangRupiah(nominal - 100); }
            else if (nominal < 1000) { temp = terbilangRupiah(Math.floor(nominal / 100)) + " Ratus" + terbilangRupiah(nominal % 100); }
            else if (nominal < 2000) { temp = " Seribu" + terbilangRupiah(nominal - 1000); }
            else if (nominal < 1000000) { temp = terbilangRupiah(Math.floor(nominal / 1000)) + " Ribu" + terbilangRupiah(nominal % 1000); }
            else if (nominal < 1000000000) { temp = terbilangRupiah(Math.floor(nominal / 1000000)) + " Juta" + terbilangRupiah(nominal % 1000000); }
            return temp.trim() + " Rupiah";
        }

