<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Sistem Informasi SPT (SI-SPT)</title>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/html2pdf.js/0.10.1/html2pdf.bundle.min.js"></script>
    <style>
        :root {
            --primary: #1e40af;
            --primary-hover: #1e3a8a;
            --secondary: #0f172a;
            --success: #16a34a;
            --bg-base: #f1f5f9;
            --bg-card: #ffffff;
            --text-main: #334155;
            --text-heading: #1e293b;
            --border-color: #cbd5e1;
            --radius: 0.5rem;
            --shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1), 0 2px 4px -1px rgba(0, 0, 0, 0.06);
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
        }

        body {
            background-color: var(--bg-base);
            color: var(--text-main);
            min-height: 100vh;
            display: flex;
            flex-direction: column;
        }

        .page {
            display: none;
            width: 100%;
            flex-grow: 1;
        }

        .page.active {
            display: flex;
        }

        /* --- TAMPILAN LOGIN --- */
        #login-page {
            align-items: center;
            justify-content: center;
            padding: 1.5rem;
        }

        .login-card {
            background-color: var(--bg-card);
            border-radius: var(--radius);
            box-shadow: var(--shadow);
            width: 100%;
            max-width: 400px;
            padding: 2.5rem 2rem;
            border: 1px solid #e2e8f0;
        }

        .login-header {
            text-align: center;
            margin-bottom: 2rem;
            width: 100%;
        }

        .login-header h2 {
            color: var(--primary);
            font-size: 1.75rem;
            margin-bottom: 0.5rem;
            font-weight: bold;
        }

        .login-header p {
            font-size: 0.875rem;
            color: #64748b;
        }

        .form-group {
            margin-bottom: 1.25rem;
            width: 100%;
        }

        .form-group label {
            display: block;
            margin-bottom: 0.5rem;
            font-weight: 600;
            font-size: 0.875rem;
            color: var(--text-heading);
        }

        .form-control {
            width: 100%;
            padding: 0.75rem 1rem;
            border: 1px solid var(--border-color);
            border-radius: var(--radius);
            font-size: 0.95rem;
            color: var(--text-heading);
            outline: none;
        }

        .form-control:focus {
            border-color: var(--primary);
            box-shadow: 0 0 0 3px rgba(30, 64, 175, 0.15);
        }

        .btn {
            width: 100%;
            padding: 0.75rem 1rem;
            background-color: var(--primary);
            color: white;
            border: none;
            border-radius: var(--radius);
            font-size: 1rem;
            font-weight: 600;
            cursor: pointer;
            transition: background-color 0.2s ease;
            text-align: center;
        }

        .btn:hover {
            background-color: var(--primary-hover);
        }

        .error-message {
            color: #ef4444;
            background-color: #fef2f2;
            border: 1px solid #fca5a5;
            padding: 0.6rem;
            border-radius: var(--radius);
            font-size: 0.85rem;
            margin-bottom: 1.25rem;
            display: none;
            text-align: center;
            font-weight: 500;
        }

        /* --- TAMPILAN DASHBOARD UTAMA --- */
        #system-page {
            flex-direction: column;
        }

        header {
            background-color: var(--secondary);
            color: white;
            padding: 1rem 2rem;
            display: flex;
            justify-content: space-between;
            align-items: center;
            box-shadow: var(--shadow);
        }

        .brand-title {
            font-size: 1.25rem;
            font-weight: 700;
            display: flex;
            align-items: center;
            gap: 0.5rem;
            color: white;
        }

        .user-profile {
            display: flex;
            align-items: center;
            gap: 1rem;
        }

        .role-badge {
            font-size: 0.75rem;
            padding: 0.2rem 0.5rem;
            border-radius: 0.25rem;
            font-weight: 600;
            text-transform: uppercase;
        }

        .role-admin {
            background-color: #dc2626;
            color: white;
        }

        .role-operator {
            background-color: #0284c7;
            color: white;
        }

        .btn-logout {
            background-color: #ef4444;
            color: white;
            border: none;
            padding: 0.5rem 1rem;
            border-radius: var(--radius);
            font-size: 0.875rem;
            font-weight: 600;
            cursor: pointer;
            transition: background-color 0.2s ease;
        }

        .btn-logout:hover {
            background-color: #dc2626;
        }

        .main-container {
            max-width: 1400px;
            width: 100%;
            margin: 0 auto;
            padding: 2rem 1.5rem;
            display: grid;
            grid-template-columns: 1fr;
            gap: 2rem;
            flex-grow: 1;
        }

        @media (min-width: 992px) {
            .main-container {
                grid-template-columns: 450px 1fr;
            }
        }

        .card {
            background-color: var(--bg-card);
            border-radius: var(--radius);
            box-shadow: var(--shadow);
            padding: 1.5rem;
            border: 1px solid #e2e8f0;
            display: flex;
            flex-direction: column;
        }

        .card-title {
            font-size: 1.25rem;
            color: var(--text-heading);
            margin-bottom: 1.25rem;
            font-weight: 700;
            border-bottom: 2px solid var(--bg-base);
            padding-bottom: 0.5rem;
        }

        .pegawai-block {
            background-color: #f8fafc;
            border: 1px solid var(--border-color);
            border-radius: var(--radius);
            padding: 1rem;
            margin-bottom: 0.75rem;
            position: relative;
        }

        .pegawai-block-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 0.75rem;
        }

        .pegawai-grid {
            display: grid;
            grid-template-columns: 1fr;
            gap: 0.5rem;
        }

        @media (min-width: 400px) {
            .pegawai-grid {
                grid-template-columns: 1fr 1fr;
            }
        }

        .btn-secondary {
            background-color: #64748b;
            color: white;
        }

        .btn-secondary:hover {
            background-color: #475569;
        }

        .btn-danger {
            background-color: #ef4444;
            color: white;
            width: auto;
            padding: 0.35rem 0.75rem;
            border-radius: 0.25rem;
            border: none;
            font-weight: 600;
            font-size: 0.8rem;
            cursor: pointer;
        }

        .btn-danger:hover {
            background-color: #dc2626;
        }

        .btn-sm {
            padding: 0.4rem 0.75rem;
            font-size: 0.875rem;
            width: auto;
        }

        .table-responsive {
            overflow-x: auto;
            width: 100%;
        }

        table {
            width: 100%;
            border-collapse: collapse;
            text-align: left;
            font-size: 0.9rem;
        }

        th {
            background-color: var(--bg-base);
            color: var(--text-heading);
            padding: 0.75rem 1rem;
            font-weight: 600;
            border-bottom: 2px solid var(--border-color);
            white-space: nowrap;
        }

        td {
            padding: 0.75rem 1rem;
            border-bottom: 1px solid var(--border-color);
            vertical-align: top;
            color: var(--text-main);
        }

        tr:hover {
            background-color: #f8fafc;
        }

        .text-muted {
            color: #64748b;
            font-size: 0.8rem;
        }

        .alert-box {
            padding: 0.75rem 1rem;
            border-radius: var(--radius);
            margin-bottom: 1rem;
            display: none;
            font-weight: 500;
            font-size: 0.9rem;
        }

        .alert-success {
            background-color: #f0fdf4;
            color: #15803d;
            border: 1px solid #bbf7d0;
        }

        ol {
            padding-left: 1.2rem;
        }

        ol li {
            margin-bottom: 0.5rem;
        }

        /* --- TAMPILAN MODAL --- */
        .modal-overlay {
            display: none;
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background-color: rgba(15, 23, 42, 0.6);
            z-index: 999;
            align-items: center;
            justify-content: center;
            padding: 1rem;
        }

        .modal-overlay.active {
            display: flex;
        }

        .modal-box {
            background-color: var(--bg-card);
            border-radius: var(--radius);
            box-shadow: 0 20px 25px -5px rgba(0,0,0,0.15);
            width: 100%;
            max-width: 700px;
            padding: 1.5rem;
            position: relative;
            animation: slideIn 0.2s ease-out;
        }

        @keyframes slideIn {
            from { transform: translateY(-15px); opacity: 0; }
            to { transform: translateY(0); opacity: 1; }
        }

        .modal-close-btn {
            position: absolute;
            top: 1rem;
            right: 1rem;
            background: none;
            border: none;
            font-size: 1.25rem;
            cursor: pointer;
            color: #94a3b8;
        }

        .modal-close-btn:hover {
            color: #475569;
        }

        .modal-title {
            font-size: 1.15rem;
            font-weight: 700;
            margin-bottom: 1rem;
            color: var(--text-heading);
            border-bottom: 2px solid var(--bg-base);
            padding-bottom: 0.5rem;
        }

        .btn-pencil {
            background-color: #f1f5f9;
            color: #334155;
            border: 1px solid #cbd5e1;
            border-radius: 0.35rem;
            padding: 0.4rem 0.6rem;
            font-size: 0.85rem;
            cursor: pointer;
            display: inline-flex;
            align-items: center;
            gap: 0.25rem;
            font-weight: 500;
            transition: all 0.2s;
        }

        .btn-pencil:hover {
            background-color: #e2e8f0;
            border-color: #94a3b8;
            color: var(--primary);
        }

        .input-biaya-modal {
            width: 100%;
            padding: 0.35rem 0.5rem;
            border: 1px solid var(--border-color);
            border-radius: 0.25rem;
            font-size: 0.85rem;
        }

        .pdf-btn-group {
            display: flex;
            flex-direction: column;
            gap: 0.25rem;
            margin-top: 0.5rem;
        }
    </style>
</head>
<body>

    <!-- HALAMAN 1: FORM LOGIN -->
    <div id="login-page" class="page active">
        <div class="login-card">
            <div class="login-header">
                <h2>SI-SPT</h2>
                <p>Sistem Informasi Entri Surat Perintah Tugas</p>
            </div>
            
            <div class="error-message" id="login-error"></div>

            <div class="form-group">
                <label for="login-operator">Pilih Nama Operator / Penginput</label>
                <select id="login-operator" class="form-control">
                    <option value="Candra Mardiyati">Candra Mardiyati</option>
                    <option value="Budi Utomo">Budi Utomo</option>
                    <option value="Siti Aminah">Siti Aminah</option>
                    <option value="Ahmad Subarjo">Ahmad Subarjo</option>
                    <option value="Admin Utama">Admin Utama (Administrator)</option>
                </select>
            </div>

            <div class="form-group">
                <label for="login-password">Kata Sandi (Password)</label>
                <input type="password" id="login-password" class="form-control" placeholder="Masukkan kata sandi akses..." required>
                <small style="color: #64748b; display: block; margin-top: 0.4rem; font-size: 0.78rem; line-height: 1.25;">
                    💡 Info: Kata sandi masing-masing operator berbeda sesuai akun yang dipilih.
                </small>
            </div>

            <button class="btn" id="btn-login">Verifikasi & Masuk</button>
        </div>
    </div>

    <!-- HALAMAN 2: DASHBOARD UTAMA SISTEM -->
    <div id="system-page" class="page">
        <header>
            <div class="brand-title">
                <span>📁 SI-SPT Dashboard</span>
            </div>
            <div class="user-profile">
                <span id="user-display" style="font-weight: 600;">Nama User</span>
                <span id="role-badge" class="role-badge">OPERATOR</span>
                <button class="btn-logout" id="btn-logout">Keluar</button>
            </div>
        </header>

        <main class="main-container">
            <!-- SEKSI KIRI: FORM ENTRI DATA -->
            <div class="card">
                <h3 class="card-title">Entri SPT Baru</h3>
                <div class="alert-box alert-success" id="form-alert">Data SPT Berhasil Disimpan!</div>
                
                <form id="spt-form" onsubmit="event.preventDefault(); eksekusiSimpanSpt();">
                    
                    <div class="form-group">
                        <label for="spt-kelompok-jabatan">Kelompok Jabatan Pelaksana</label>
                        <select id="spt-kelompok-jabatan" class="form-control" onchange="muatNomorOtomatis()">
                            <option value="FUNGSIONAL">Jabatan Fungsional ke Bawah</option>
                            <option value="ESELON">Eselon III ke Atas</option>
                        </select>
                        <small style="color: #64748b; display: block; margin-top: 0.35rem; font-size: 0.8rem; line-height: 1.2;" id="spt-keterangan-jabatan">
                            * Catatan: Nomor SPT and Nomor SPPD terisi otomatis melanjutkan urutan data.
                        </small>
                    </div>

                    <div class="form-group">
                        <label for="spt-nomor">Nomor SPT</label>
                        <input type="text" id="spt-nomor" class="form-control" readonly style="background-color: #e2e8f0; font-weight: 600; color: var(--primary); cursor: not-allowed;">
                    </div>

                    <div class="form-group">
                        <label for="sppd-nomor">Nomor SPPD (Otomatis)</label>
                        <input type="text" id="sppd-nomor" class="form-control" readonly style="background-color: #e2e8f0; font-weight: 600; color: #b91c1c; cursor: not-allowed;">
                    </div>

                    <div class="form-group">
                        <label for="spt-dasar">Dasar Penugasan</label>
                        <textarea id="spt-dasar" class="form-control" rows="2" placeholder="Contoh: Jadwal Kegiatan Bupati dan Wakil Bupati Lumajang" required></textarea>
                    </div>

                    <div class="form-group">
                        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.5rem;">
                            <label style="margin-bottom: 0; font-weight: 600;">Daftar Pegawai Pelaksana</label>
                            <button type="button" class="btn btn-secondary btn-sm" onclick="tambahBarisPegawai()">+ Tambah Pegawai</button>
                        </div>
                        <div id="pegawai-container">
                            <!-- Komponen nama pelaksana dimasukkan via JS -->
                        </div>
                    </div>

                    <div class="form-group">
                        <label for="spt-maksud">Maksud / Perihal Tugas</label>
                        <textarea id="spt-maksud" class="form-control" rows="2" placeholder="Contoh: Mengatur dan mempersiapkan kehadiran Bupati dan Wakil Bupati..." required></textarea>
                    </div>

                    <div class="form-group">
                        <label for="spt-tujuan">Kota / Tempat Tujuan</label>
                        <input type="text" id="spt-tujuan" class="form-control" placeholder="Contoh: Senduro" required>
                    </div>

                    <div class="form-group">
                        <label for="spt-tanggal-spt">Tanggal Surat Perintah Tugas</label>
                        <input type="date" id="spt-tanggal-spt" class="form-control" required>
                    </div>

                    <div class="form-group">
                        <label>Tanggal Pelaksanaan Perjalanan Dinas</label>
                        <div style="display: flex; gap: 0.5rem;">
                            <input type="date" id="spt-tanggal-mulai" class="form-control" required style="flex: 1;">
                            <span style="align-self: center; font-size: 0.85rem; color: #64748b; font-weight: 600;">s/d</span>
                            <input type="date" id="spt-tanggal-selesai" class="form-control" required style="flex: 1;">
                        </div>
                    </div>

                    <button type="submit" class="btn" style="background-color: var(--success);" id="btn-submit-form">Simpan ke Spreadsheet</button>
                </form>
            </div>

            <!-- SEKSI KANAN: TABEL RIWAYAT DATA -->
            <div class="card">
                <h3 class="card-title" id="tabel-title">Daftar Surat Perintah Tugas</h3>
                <div class="table-responsive">
                    <table>
                        <thead>
                            <tr>
                                <th>No SPT / SPPD / Dasar</th>
                                <th>Informasi Perjalanan</th>
                                <th>Daftar Pegawai Pelaksana</th>
                                <th>Menu Dokumen</th>
                                <th>Input Oleh</th>
                            </tr>
                        </thead>
                        <tbody id="spt-table-body">
                            <!-- Data baris dimuat lewat JavaScript -->
                        </tbody>
                    </table>
                </div>
            </div>
        </main>
    </div>

    <!-- MODAL EDIT/INPUT NOMINAL BIAYA -->
    <div id="financial-modal" class="modal-overlay">
        <div class="modal-box">
            <button class="modal-close-btn" onclick="tutupModalBiaya()">✕</button>
            <h4 class="modal-title" id="modal-doc-title">Kelola Komponen Keuangan Per Pegawai</h4>
            
            <input type="hidden" id="modal-target-sppd">
            
            <div class="table-responsive" style="margin-bottom: 1.5rem;">
                <table style="font-size: 0.85rem;">
                    <thead>
                        <tr style="background-color: #f8fafc;">
                            <th style="padding: 0.5rem; width: 35%;">Nama Pegawai</th>
                            <th style="padding: 0.5rem; width: 20%;">Uang Harian (Rp)</th>
                            <th style="padding: 0.5rem; width: 20%;">Penginapan (Rp)</th>
                            <th style="padding: 0.5rem; width: 20%;">Transport (Rp)</th>
                        </tr>
                    </thead>
                    <tbody id="modal-table-body">
                        <!-- Komponen input finansial dinamis dimuat via JS -->
                    </tbody>
                </table>
            </div>
            
            <div style="display: flex; gap: 0.5rem; justify-content: flex-end;">
                <button type="button" class="btn btn-secondary btn-sm" onclick="tutupModalBiaya()">Batal</button>
                <button type="button" class="btn btn-sm" style="background-color: var(--success);" onclick="eksekusiUpdateBiayaServer()">
                    💾 Simpan Biaya
                </button>
            </div>
        </div>
    </div>

    <script>
        const isAppsScriptEnv = typeof google !== 'undefined' && google.script && google.script.run;

        let currentUser = { operator: '', role: 'OPERATOR' };
        let cacheDaftarSpt = []; 

        const DB_KEY = "DATA_SPT_BIAYA_OFFICIAL_V5";
        
        function inisialisasiDataBawaan() {
            if (!localStorage.getItem(DB_KEY)) {
                const dummyData = [
                    {
                        nomorSpt: "800.1.11.1/024/427.17/2026",
                        nomorSppd: "800.1.2.3/024/427.17/2026",
                        dasar: "Jadwal Kegiatan Bupati dan Wakil Bupati Lumajang",
                        tanggalSpt: "2026-10-27",
                        kelompokJabatan: "FUNGSIONAL",
                        maksud: "mengatur dan mempersiapkan kehadiran Bupati dan Wakil Bupati Lumajang pada acara \"Upacara Peringatan Hari Sumpah Pemuda ke-98 Tahun 2026\" yang bertempat di Bumi Perkemahan Glagah Arum Desa kandang Tepus Kecamatan Senduro.",
                        tujuan: "Senduro",
                        tanggalMulai: "2026-10-28",
                        tanggalSelesai: "2026-10-28",
                        operator: "Candra Mardiyati",
                        tim: [
                            { nip: "19750429 201001 2 006", nama: "CANDRA MARDIYATI, S.M.", pangkat: "Penata / III c", jabatanPegawai: "Penata Perjalanan Dinas", uangHarian: 370000, penginapan: 500000, transport: 250000 },
                            { nip: "19930629 202504 2 002", nama: "SISKA HARIYANTI, A.Md", pangkat: "Pengatur / II c", jabatanPegawai: "Staf Protokol", uangHarian: 0, penginapan: 0, transport: 0 },
                            { nip: "19980527 202521 1 061", nama: "INDRA IBRAHIM", pangkat: "-", jabatanPegawai: "Staf Operasional", uangHarian: 0, penginapan: 0, transport: 0 },
                            { nip: "19931227 202521 2 096", nama: "VINY WARDATUR R", pangkat: "-", jabatanPegawai: "Staf", uangHarian: 0, penginapan: 0, transport: 0 }
                        ]
                    }
                ];
                localStorage.setItem(DB_KEY, JSON.stringify(dummyData));
            }
        }

        function muatNomorOtomatis() {
            const kelompok = document.getElementById('spt-kelompok-jabatan').value;
            const keteranganText = document.getElementById('spt-keterangan-jabatan');
            
            if (isAppsScriptEnv) {
                google.script.run
                    .withSuccessHandler(function(nomorSppdResmi) {
                        document.getElementById('sppd-nomor').value = nomorSppdResmi;
                    })
                    .getBerikutnyaNomorSppd();
                
                if (kelompok === "ESELON") {
                    document.getElementById('spt-nomor').value = "-";
                    keteranganText.innerText = "* Catatan: Kelompok Eselon III ke Atas terpilih. Nomor SPT otomatis dikosongi (-), tetapi nomor SPPD tetap terisi otomatis.";
                } else {
                    document.getElementById('spt-nomor').value = "Memuat...";
                    google.script.run
                        .withSuccessHandler(function(nomorResmi) {
                            document.getElementById('spt-nomor').value = nomorResmi;
                        })
                        .getBerikutnyaNomorSpt();
                    keteranganText.innerText = "* Catatan: Nomor SPT and Nomor SPPD terisi otomatis melanjutkan urutan data.";
                }
            } else {
                const dataMentah = localStorage.getItem(DB_KEY);
                const daftarSpt = dataMentah ? JSON.parse(dataMentah) : [];
                let countSpt = 0;
                daftarSpt.forEach(item => { if (item.nomorSpt && item.nomorSpt.trim() !== "-") countSpt++; });
                
                const nextCounterSpt = String(countSpt + 1).padStart(3, '0');
                const nextCounterSppd = String(daftarSpt.length + 1).padStart(3, '0');
                
                document.getElementById('sppd-nomor').value = `800.1.2.3/${nextCounterSppd}/427.17/2026`;
                if (kelompok === "ESELON") {
                    document.getElementById('spt-nomor').value = "-";
                } else {
                    document.getElementById('spt-nomor').value = `800.1.11.1/${nextCounterSpt}/427.17/2026`;
                }
            }
        }

        window.addEventListener('DOMContentLoaded', () => {
            inisialisasiDataBawaan();
            tambahBarisPegawai(); 
            document.getElementById('btn-login').addEventListener('click', eksekusiLogin);
            document.getElementById('btn-logout').addEventListener('click', eksekusiLogout);
            document.getElementById('spt-tanggal-spt').value = new Date().toISOString().split('T')[0];
        });

        function eksekusiLogin() {
            const inputNama = document.getElementById('login-operator').value.trim();
            const inputSandi = document.getElementById('login-password').value;
            const errorElement = document.getElementById('login-error');
            
            errorElement.style.display = 'none';

            const DAFTAR_KREDENSIAL = {
                "Candra Mardiyati": { sandi: "candra123", role: "OPERATOR" },
                "Budi Utomo":      { sandi: "budi123",   role: "OPERATOR" },
